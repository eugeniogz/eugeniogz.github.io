---
layout: null
permalink: /search.json
---
{%- assign p1 = site.pages | where_exp: "item", "item.title != nil" -%}
{%- assign p2 = p1 | where_exp: "item", "item.search != false" -%}
{%- assign p3 = p2 | where_exp: "item", "item.name != '404.html'" -%}
{%- assign p4 = p3 | where_exp: "item", "item.name != 'Search.html'" -%}
{%- assign p5 = p4 | where_exp: "item", "item.name != 'search.json'" -%}
{%- assign p6 = p5 | where_exp: "item", "item.name != 'sitemap.xml'" -%}
{%- assign p7 = p6 | where_exp: "item", "item.name != 'index.html'" -%}
{%- assign searchable_pages = p7 | where_exp: "item", "item.name != 'index.md'" -%}
{%- assign posts_with_title = site.posts | where_exp: "item", "item.title != nil" -%}
{%- assign searchable_posts = posts_with_title | where_exp: "item", "item.search != false" -%}
{%- assign filtered_items = searchable_pages | concat: searchable_posts -%}
[
  {%- for item in filtered_items -%}
    {%- assign raw_body = item.content | split: '<div style="display: flex; justify-content: space-between;' | first -%}
    {%- assign raw_body = raw_body | split: '<div style="display:flex; justify-content:space-between;' | first -%}
    {%- assign raw_body = raw_body | split: '<div style="display:flex;justify-content:space-between;' | first -%}
    {%- assign raw_body = raw_body | split: '<div class="reflexao-nav-footer' | first -%}
    {%- assign raw_body = raw_body | split: '<div class="article-nav' | first -%}
    {
      "title"        : {{ item.title | jsonify }},
      "url"          : {{ item.url | relative_url | jsonify }},
      "content"      : {{ raw_body | strip_html | strip_newlines | jsonify }},
      "tags"         : {{ item.tags | join: ", " | jsonify }},
      "reading_time" : "{{ item.reading_time | default: 1 }}",
      {% if item.date %}
      "type"         : "post"
      {% else %}
      "type"         : "page"
      {% endif %}
    }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
]